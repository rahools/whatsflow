{
  "name": "@whatsflow/nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev --turbopack",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "@whatsflow/api": "workspace:*",
    "@whatsflow/auth": "workspace:*",
    "@whatsflow/db": "workspace:*",
    "@whatsflow/ui": "workspace:*",
    "@whatsflow/validators": "workspace:*",
    "geist": "^1.3.1",
    "next": "^15.2.3",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "superjson": "2.2.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@whatsflow/eslint-config": "workspace:*",
    "@whatsflow/prettier-config": "workspace:*",
    "@whatsflow/tailwind-config": "workspace:*",
    "@whatsflow/tsconfig": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "eslint": "catalog:",
    "jiti": "^1.21.7",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@whatsflow/prettier-config"
}
